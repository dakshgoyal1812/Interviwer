# ============================================================================
# INTERVIEWX AI — ENVIRONMENT CONFIGURATION (.env)
# All privileged keys live on the Render backend ONLY. Never expose them in
# frontend JS. The frontend receives only the two VITE_* public values below.
# ============================================================================

# --- Runtime ---
PORT=8080
# Comma-separated frontend origins allowed by CORS (frontend on Vercel).
# Use * for local development.
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# FRONTEND PUBLIC VALUES (safe to expose — protected by Supabase RLS)
# These are the only two variables the browser ever sees.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-publishable-anon-key"
# When frontend (Vercel) and backend (Render) are deployed separately, point
# the frontend at the Render backend. Leave empty when the Express server
# serves the built frontend itself (single-origin mode).
VITE_API_BASE=""

# ---------------------------------------------------------------------------
# LLM — WAGURI KEYPOOL MULTI-PROVIDER FREE ROTATION (OpenAI-compatible)
# Comma-separated keys; rotation with per-key cooldown on HTTP 429.
# Any OpenAI-compatible provider works (OpenRouter, Groq, NVIDIA NIM, ...).
# ---------------------------------------------------------------------------
LLM_API_KEYS="sk-or-v1-key1,sk-or-v1-key2,gsk_key3"
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_MODEL="meta-llama/llama-3.3-70b-instruct:free"
# Optional secondary provider used when the KeyPool is exhausted/absent.
GEMINI_API_KEY=""

# ---------------------------------------------------------------------------
# SUPABASE (server-side; the service/secret key NEVER leaves the backend)
# Run supabase/schema.sql in the SQL editor once, then `npm run seed`.
# ---------------------------------------------------------------------------
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-or-secret-key"
SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# ---------------------------------------------------------------------------
# VOICE / TTS — Edge TTS is the PRIMARY engine (keyless, free).
# Azure Speech is the first fallback (free tier F0, card required only for
# upgrades). Gemini TTS is the second fallback. Browser SpeechSynthesis is
# the final in-browser fallback, so voice always works.
# ---------------------------------------------------------------------------
EDGE_TTS_VOICE_DEFAULT="en-US-AriaNeural"
EDGE_TTS_VOICE_HR="en-US-AriaNeural"
EDGE_TTS_VOICE_TECH="en-US-GuyNeural"
EDGE_TTS_VOICE_CORP="en-GB-SoniaNeural"
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="eastus"

# ---------------------------------------------------------------------------
# CODE EXECUTION SANDBOX — candidate code NEVER executes on this server.
# Primary: Piston (free hosted). Secondary: Judge0 CE (free/self-hosted).
# Last resort: offline heuristic keeps the app usable if both are unreachable.
# ---------------------------------------------------------------------------
CODE_SANDBOX_PROVIDER="piston" # "piston" | "judge0"
PISTON_API_URL="https://emkc.org/api/v2/piston"
JUDGE0_API_URL="https://ce.judge0.com"
JUDGE0_API_KEY=""
